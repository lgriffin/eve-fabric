{
  "name": "@eve-fabric/fabric",
  "version": "0.1.0",
  "description": "The composition root as a library: sources and packs in, a fabric out.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgriffin/eve-fabric.git",
    "directory": "packages/fabric"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eve-fabric/cache": "workspace:*",
    "@eve-fabric/compiler": "workspace:*",
    "@eve-fabric/core": "workspace:*",
    "@eve-fabric/executor": "workspace:*",
    "@eve-fabric/kit": "workspace:*",
    "@eve-fabric/source-esi": "workspace:*",
    "@eve-fabric/source-sde": "workspace:*",
    "@eve-fabric/weave": "workspace:*",
    "@lgriffin/esi.ts": "11.1.1",
    "graphql": "^16.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eve-fabric/pack-core": "workspace:*",
    "@eve-fabric/fixture": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
