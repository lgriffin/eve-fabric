{
  "name": "@eve-fabric/persistence",
  "version": "0.1.0",
  "description": "EVE Fabric's Store port over SQLite, through Node's own node:sqlite.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgriffin/eve-fabric.git",
    "directory": "packages/persistence"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eve-fabric/core": "workspace:*",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
