{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "bank/steps/**/*.ts", "examples/**/*.ts"],
      "project": ["scripts/**/*.ts", "bank/**/*.ts", "examples/**/*.ts"],
      "ignoreDependencies": ["@stryker-mutator/api", "@eve-fabric/compiler", "@eve-fabric/planner"],
      "typedoc": false
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["tests/bdd/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/codegen": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@lgriffin/esi.ts"]
    },
    "packages/persistence": {
      "project": ["src/**/*.ts"]
    },
    "apps/gateway": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/designer": {
      "entry": ["e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    }
  }
}
