{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@stryker-mutator/api",
        "@eve-fabric/domain",
        "@eve-fabric/compiler",
        "@eve-fabric/planner",
        "@eve-fabric/schema-package",
        "@eve-fabric/esi-adapter",
        "@eve-fabric/sde-adapter",
        "lint-staged"
      ],
      "typedoc": false
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["tests/bdd/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test-support": {
      "entry": ["src/bdd/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/persistence": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["drizzle-kit"]
    },
    "apps/gateway": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@eve-fabric/planner"]
    },
    "apps/designer": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@eve-fabric/planner", "@eve-fabric/executor", "@eve-fabric/graphql"]
    }
  },
  "ignore": [".husky/**"]
}
