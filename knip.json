{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "bank/steps/**/*.ts", "examples/**/*.ts"],
      "project": ["scripts/**/*.ts", "bank/**/*.ts", "examples/**/*.ts"],
      "ignoreDependencies": [
        "@stryker-mutator/api",
        "@eve-fabric/compiler",
        "@eve-fabric/planner",
        "lint-staged"
      ],
      "typedoc": false
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["tests/bdd/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/persistence": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["drizzle-kit"]
    },
    "apps/gateway": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/designer": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [".husky/**"]
}
