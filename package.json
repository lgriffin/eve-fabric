{
  "name": "eve-fabric",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @eve-fabric/core run build && pnpm -r run build",
    "test": "vitest run",
    "test:bdd": "cucumber-js -c cucumber.cjs",
    "test:watch": "vitest",
    "test:property": "vitest run --reporter=verbose property",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "pnpm -r run typecheck && tsc -p examples",
    "knip": "knip",
    "docs": "typedoc",
    "mutate": "stryker run",
    "test:mutation": "stryker run",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "demo": "tsx examples/e2e-demo/demo.ts",
    "demo:esi": "tsx examples/esi-live.ts",
    "quickstart": "tsx examples/quickstart/main.ts",
    "fabric": "tsx apps/cli/src/main.ts",
    "workbench": "tsx scripts/workbench.ts",
    "validate": "pnpm run lint && pnpm run lint:layers && pnpm run lint:determinism && pnpm run format:check && pnpm run typecheck && pnpm run coverage && pnpm --filter @eve-fabric/designer run coverage && pnpm run knip",
    "prepare": "husky",
    "lint:layers": "tsx scripts/lint-layers.ts",
    "lint:determinism": "tsx scripts/lint-determinism.ts",
    "test:bank": "tsx scripts/question-bank.ts",
    "weaves": "tsx scripts/export-weaves.ts",
    "weaves:check": "tsx scripts/export-weaves.ts --check",
    "packages:check": "tsx scripts/check-packages.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@cucumber/cucumber": "11.3.0",
    "@eslint/js": "^9.0.0",
    "@eve-fabric/core": "workspace:*",
    "@eve-fabric/fabric": "workspace:*",
    "@eve-fabric/kit": "workspace:*",
    "@eve-fabric/pack-core": "workspace:*",
    "@eve-fabric/source-sde": "workspace:*",
    "@eve-fabric/test-support": "workspace:*",
    "@eve-fabric/weave": "workspace:*",
    "@lgriffin/esi.ts": "11.1.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^3.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "knip": "^5.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.9.0"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
