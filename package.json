{
  "name": "eve-fabric",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:bdd": "node node_modules/.pnpm/@cucumber+cucumber@11.3.0/node_modules/@cucumber/cucumber/bin/cucumber.js -c cucumber.cjs",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "pnpm -r run typecheck",
    "docs": "typedoc",
    "mutate": "stryker run",
    "test:mutation": "stryker run",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.9.0"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
